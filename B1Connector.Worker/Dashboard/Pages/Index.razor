@page "/dashboard/{Key}"
@using B1Connector.Worker.Dashboard.Models
@inject DashboardAuthService AuthService
@inject DashboardDataService DataService
@inject NavigationManager Nav
@rendermode InteractiveServer


@if (!_authenticated)
{
    <p style="font-family:sans-serif;padding:2rem;">Checking authentication...</p>
}
else
{
    <div style="font-family:sans-serif;max-width:1100px;margin:0 auto;padding:2rem;">

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;">
            <h1 style="margin:0;font-size:22px;">
                @(_isAdmin ? "Admin Dashboard" : $"Dashboard — {_tenantId}")
            </h1>
            @if (_isAdmin)
            {
                <a href="/dashboard/tenants/new/@Key"
                style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:#2563eb;color:white;border-radius:6px;font-size:13px;text-decoration:none;">
                    + Add client
                </a>
            }
            <span style="font-size:13px;color:#666;">
                @(_isAdmin ? "Admin" : "Client") view
            </span>
        </div>

        <!-- Stats cards -->
        @if (_stats is not null)
        {
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:2rem;">
                <div style="@CardStyle("#EFF6FF","#1D4ED8")">
                    <div style="font-size:12px;color:#666;">Total</div>
                    <div style="font-size:28px;font-weight:600;">@_stats.Total</div>
                </div>
                <div style="@CardStyle("#F0FDF4","#15803D")">
                    <div style="font-size:12px;color:#666;">Completed</div>
                    <div style="font-size:28px;font-weight:600;">@_stats.Completed</div>
                </div>
                <div style="@CardStyle("#FFF7ED","#C2410C")">
                    <div style="font-size:12px;color:#666;">Failed</div>
                    <div style="font-size:28px;font-weight:600;">@_stats.Failed</div>
                </div>
                <div style="@CardStyle("#FEFCE8","#A16207")">
                    <div style="font-size:12px;color:#666;">Pending</div>
                    <div style="font-size:28px;font-weight:600;">@_stats.Pending</div>
                </div>
                <div style="@CardStyle("#F5F3FF","#6D28D9")">
                    <div style="font-size:12px;color:#666;">Processing</div>
                    <div style="font-size:28px;font-weight:600;">@_stats.Processing</div>
                </div>
            </div>
        }

        <!-- Tenant summaries (admin only) -->
        @if (_isAdmin && _tenantSummaries is not null)
        {
            <h2 style="font-size:16px;font-weight:600;margin-bottom:12px;">Tenants</h2>
            <table style="@TableStyle">
                <thead>
                    <tr style="background:#F9FAFB;">
                        <th style="@ThStyle">Shop Domain</th>
                        <th style="@ThStyle">Status</th>
                        <th style="@ThStyle">Total Jobs</th>
                        <th style="@ThStyle">Completed</th>
                        <th style="@ThStyle">Failed</th>
                        <th style="@ThStyle">Last Job</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in _tenantSummaries)
                    {
                        <tr style="border-bottom:1px solid #F3F4F6;">
                            <td style="@TdStyle">@tenant.ShopDomain</td>
                            <td style="@TdStyle">
                                <span style="@BadgeStyle(tenant.IsActive ? "green" : "red")">
                                    @(tenant.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td style="@TdStyle">@tenant.TotalJobs</td>
                            <td style="@TdStyle">@tenant.CompletedJobs</td>
                            <td style="@TdStyle">@tenant.FailedJobs</td>
                            <td style="@TdStyle">@(tenant.LastJobAt?.ToString("dd MMM HH:mm") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- Sync Jobs -->
        <h2 style="font-size:16px;font-weight:600;margin:2rem 0 12px;">Sync Jobs</h2>
        <table style="@TableStyle">
            <thead>
                <tr style="background:#F9FAFB;">
                    <th style="@ThStyle">ID</th>
                    @if (_isAdmin) { <th style="@ThStyle">Tenant</th> }
                    <th style="@ThStyle">Type</th>
                    <th style="@ThStyle">Status</th>
                    <th style="@ThStyle">Retries</th>
                    <th style="@ThStyle">Created</th>
                    <th style="@ThStyle">Processed</th>
                    <th style="@ThStyle">Logs</th>
                </tr>
            </thead>
            <tbody>
                @if (_jobs is not null)
                {
                    @foreach (var job in _jobs)
                    {
                        <tr style="border-bottom:1px solid #F3F4F6;">
                            <td style="@TdStyle">@job.Id</td>
                            @if (_isAdmin) { <td style="@TdStyle" title="@job.TenantId">@job.TenantId.Split('.')[0]</td> }
                            <td style="@TdStyle">@job.ConnectorType</td>
                            <td style="@TdStyle">
                                <span style="@BadgeStyle(StatusColor(job.Status))">@job.Status</span>
                            </td>
                            <td style="@TdStyle">@job.RetryCount</td>
                            <td style="@TdStyle">@job.CreatedAt.ToString("dd MMM HH:mm")</td>
                            <td style="@TdStyle">@(job.ProcessedAt?.ToString("dd MMM HH:mm") ?? "—")</td>
                            <td style="@TdStyle">
                                <button @onclick="() => ToggleLogs(job.Id)"
                                        style="font-size:12px;padding:3px 8px;border:1px solid #ddd;border-radius:4px;cursor:pointer;background:white;">
                                    @(_expandedJobId == job.Id ? "Hide" : "View")
                                </button>
                            </td>
                        </tr>
                        @if (_expandedJobId == job.Id && _logs is not null)
                        {
                            <tr>
                                <td colspan="@(_isAdmin ? 8 : 7)"
                                    style="padding:12px;background:#F9FAFB;">
                                    @if (_logs.Count == 0)
                                    {
                                        <p style="font-size:13px;color:#666;margin:0;">No logs for this job.</p>
                                    }
                                    else
                                    {
                                        @foreach (var log in _logs)
                                        {
                                            <div style="margin-bottom:6px;font-size:12px;">
                                                <span style="color:#999;">@log.CreatedAt.ToString("HH:mm:ss")</span>
                                                <span style="@LogLevelStyle(log.Level);margin:0 6px;">[@log.Level]</span>
                                                <span>@log.Message</span>
                                                @if (!string.IsNullOrEmpty(log.Detail))
                                                {
                                                    <div style="margin-top:4px;padding:6px;background:#fff;border:1px solid #eee;border-radius:4px;font-family:monospace;white-space:pre-wrap;color:#555;">@log.Detail</div>
                                                }
                                            </div>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <div style="display:flex;gap:8px;margin-top:1rem;align-items:center;">
            <button @onclick="PrevPage" disabled="@(_page == 1)"
                    style="padding:6px 12px;border:1px solid #ddd;border-radius:4px;cursor:pointer;background:white;">
                ← Prev
            </button>
            <span style="font-size:13px;color:#666;">Page @_page of @TotalPages</span>
            <button @onclick="NextPage" disabled="@(_page >= TotalPages)"
                    style="padding:6px 12px;border:1px solid #ddd;border-radius:4px;cursor:pointer;background:white;">
                Next →
            </button>
            <button @onclick="RefreshAsync"
                    style="padding:6px 12px;border:1px solid #2563eb;color:#2563eb;border-radius:4px;cursor:pointer;background:white;margin-left:auto;">
                ↺ Refresh
            </button>
        </div>

    </div>
}

@code {
    [Parameter]
    public string? Key { get; set; }

    private bool _authenticated;
    private bool _isAdmin;
    private string? _tenantId;
    private DashboardStats? _stats;
    private List<TenantSummary>? _tenantSummaries;
    private List<SyncJob>? _jobs;
    private List<SyncLog>? _logs;
    private int _expandedJobId = -1;
    private int _page = 1;
    private int _totalJobs;
    private const int PageSize = 20;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalJobs / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Key))
        {
            Nav.NavigateTo("/dashboard/{Uri.EscapeDataString(Key)}", forceLoad: true);
            return;
        }

        var (isValid, isAdmin, tenantId) = await AuthService.ValidateAsync(Key);
        if (!isValid)
        {
            Nav.NavigateTo($"/dashboard/{Uri.EscapeDataString(Key)}", forceLoad: true);
            return;
        }

        _authenticated = true;
        _isAdmin = isAdmin;
        _tenantId = tenantId;

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _stats = await DataService.GetStatsAsync(_isAdmin ? null : _tenantId);
        _totalJobs = await DataService.GetJobCountAsync(_isAdmin ? null : _tenantId);
        _jobs = await DataService.GetJobsAsync(_isAdmin ? null : _tenantId, _page, PageSize);

        if (_isAdmin)
            _tenantSummaries = await DataService.GetAllTenantsSummariesAsync();
    }

    private async Task ToggleLogs(int jobId)
    {
        if (_expandedJobId == jobId)
        {
            _expandedJobId = -1;
            _logs = null;
        }
        else
        {
            _expandedJobId = jobId;
            _logs = await DataService.GetLogsForJobAsync(jobId);
        }
    }

    private async Task RefreshAsync()
    {
        _expandedJobId = -1;
        _logs = null;
        await LoadDataAsync();
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadDataAsync(); }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages) { _page++; await LoadDataAsync(); }
    }

    private static string StatusColor(SyncJobStatus status) => status switch
    {
        SyncJobStatus.Completed => "green",
        SyncJobStatus.Failed => "red",
        SyncJobStatus.Processing => "blue",
        _ => "yellow"
    };

    private static string CardStyle(string bg, string color) =>
        $"background:{bg};border-radius:8px;padding:16px;";

    private static string BadgeStyle(string color) => color switch
    {
        "green" => "background:#DCFCE7;color:#15803D;padding:2px 8px;border-radius:12px;font-size:12px;",
        "red" => "background:#FEE2E2;color:#DC2626;padding:2px 8px;border-radius:12px;font-size:12px;",
        "blue" => "background:#DBEAFE;color:#1D4ED8;padding:2px 8px;border-radius:12px;font-size:12px;",
        "yellow" => "background:#FEF9C3;color:#A16207;padding:2px 8px;border-radius:12px;font-size:12px;",
        _ => "background:#F3F4F6;color:#374151;padding:2px 8px;border-radius:12px;font-size:12px;"
    };

    private static string LogLevelStyle(SyncLogLevel level) => level switch
    {
        SyncLogLevel.Error => "color:#DC2626;font-weight:600;",
        SyncLogLevel.Warning => "color:#D97706;font-weight:600;",
        _ => "color:#059669;font-weight:600;"
    };

    private const string TableStyle =
        "width:100%;border-collapse:collapse;border:1px solid #E5E7EB;border-radius:8px;overflow:hidden;font-size:13px;";
    private const string ThStyle =
        "text-align:left;padding:10px 12px;font-size:12px;color:#6B7280;font-weight:500;border-bottom:1px solid #E5E7EB;";
    private const string TdStyle =
        "padding:10px 12px;color:#374151;";
}