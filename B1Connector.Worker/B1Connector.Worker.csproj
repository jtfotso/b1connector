    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-B1Connector.Worker-f3e2e0b5-a0f7-4400-b837-159fd16945b3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
